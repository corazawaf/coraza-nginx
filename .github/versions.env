# Central version + sha256 pins for all CI workflows.
#
# SINGLE SOURCE OF TRUTH. Every workflow sources this file into $GITHUB_ENV as
# its first step (via .github/scripts/load-versions.sh); the monthly bump.yml
# job re-pins it and opens a PR. Tarballs/zips are pinned by version string
# (release archives are immutable) AND verified against the sha256 recorded
# here, so a compromised/changed upstream archive fails the build.
#
# To bump manually: edit versions here, refresh the matching *_SHA256 with
#   .github/scripts/fetch-verify.sh <url> - <out>   (prints the sha on mismatch)
# or just let bump.yml do it. compute-versions.sh rewrites ONLY the keys it
# resolves, in place; pins it does not own (GO_FTW_VERSION, NGINX_TESTS_*)
# are maintained by hand here and survive the bump.
# Keep KEY=value, no spaces, no quotes — this file is both `source`d by scripts
# and `cat`d into $GITHUB_ENV.

# nginx mainline (odd minor) — built + prove + go-ftw in build.yml
NGINX_MAINLINE=1.31.4
NGINX_MAINLINE_SHA256=e6f20b644a17a643f059ae6467a1971fe2811587d025e071068753a1f1e3b3c3

# nginx stable (even minor) — built + prove + go-ftw in build.yml
NGINX_STABLE=1.30.4
NGINX_STABLE_SHA256=4261dc90e9e47c1c4041276e9aaa3d48ebe2e664f728e14fa95ae6c67d57a08b

# nginx version used by the deep/soak/scanner jobs (mainline)
NGINX_VERSION=1.31.4
NGINX_VERSION_SHA256=e6f20b644a17a643f059ae6467a1971fe2811587d025e071068753a1f1e3b3c3

# Angie (webserver-llc) — build-only cell in build.yml; full soak in ci-deep
ANGIE_VERSION=Angie-1.12.1
ANGIE_SHA256=47f99ce14bf2e3942017cc145c7ee69a267d61ba5a75ecf300609959de92be00

# libcoraza (cgo shared lib the module links against)
#
# 1.8 is the FLOOR: it exports coraza_is_response_body_accessible(), which the
# header filter needs to know whether a response body will be inspected at all
# (issue #140); the module's version gate refuses anything older at startup and
# `config` refuses older headers at build time (debian/control pins libcoraza
# >= 1.8 to match). This pin tracks the latest release so CI builds against
# what the PPA ships.
LIBCORAZA_VERSION=v1.8.0
LIBCORAZA_SHA256=6a6b18e1747c811960d05cb656a58f100bfd643ee35b115021dc3fcb795193bd

# OWASP CRS — LTS line (used by build.yml go-ftw regression run)
CRS_VERSION=4.25.1
CRS_SHA256=0539e66e7627fe71c160a644d8fb7ab6e450d53c9de208be5f95a35c70e1a154

# nginx-tests — no upstream releases, so pinned to an immutable commit SHA
# (GitHub source tarballs are byte-stable per commit) + verified sha256.
# Bump by hand: pick a nginx/nginx-tests commit, refresh the sha with
#   .github/scripts/fetch-verify.sh <archive-url> - <out>
NGINX_TESTS_REF=76bb761cdcaeb6cb024d605c2ef91bf8d8a602d7
NGINX_TESTS_SHA256=d67d4237799cd3c9509f2555336fed65f3ceb3a6266f8caf71842cac14bb40cd

# go-ftw (test runner, installed via `go install`, pinned by tag only)
GO_FTW_VERSION=v2.1.0
